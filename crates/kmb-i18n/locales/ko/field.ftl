# field-asm-constraint-rows = Face Pairs
# field-asm-constraint-rows-a = Component 1 Faces
# field-asm-constraint-rows-a-help = Planar or cylindrical face, straight edge or vertex on the moving component. For Midplane, select two to use their midpoint.
# field-asm-constraint-rows-angle = Angle
# field-asm-constraint-rows-angle-help = Angle between the two face directions. Blank means 0.
# field-asm-constraint-rows-b = Component 2 Faces
# field-asm-constraint-rows-b-help = Planar or cylindrical face, straight edge or vertex on the target component. For Midplane, use two parallel faces.
# field-asm-constraint-rows-b-to = Component 2 Target
# field-asm-constraint-rows-b-to-help = Aligns to geometry on component 2 (face, edge or point), or to the origin or an origin plane.
# field-asm-constraint-rows-flip = Flip
# field-asm-constraint-rows-flip-help = For Mate, aligns planar face directions or reverses cylinder axes. For Angle, reverses component 1's direction. For Tangent, makes cylinders internally tangent.
# field-asm-constraint-rows-help = Each row constrains faces on component 1 and component 2. All rows are solved together after earlier constraints and joints have been applied in timeline order.
# field-asm-constraint-rows-kind = Type
# field-asm-constraint-rows-kind-help = Mate opposes planar faces (Flip makes them flush) or aligns cylinder axes. Angle sets the angle between face directions. Midplane centers between two parallel faces on component 2. Tangent makes planes and cylinders, or two cylinders, touch.
# field-asm-constraint-rows-offset = Offset
# field-asm-constraint-rows-offset-help = Distance between faces; offset from center for Midplane or separation from contact for Tangent. Blank means 0.
# field-asm-fastener-flip = Reverse Direction
# field-asm-fastener-flip-help = Points inward into the hole for insertion from the back.
# field-asm-fastener-kind = Type
# field-asm-fastener-kind-help = After changing the type, choose a nominal size from the new list.
# field-asm-fastener-length = Length
# field-asm-fastener-length-help = Length below the head. Countersunk screws use overall length including the head.
# field-asm-fastener-material = Material
# field-asm-fastener-material-help = Used for mass in the bill of materials unless the body has its own material.
# field-asm-fastener-offset = Offset
# field-asm-fastener-offset-help = Outward offset from the hole-opening face. For parts inserted above washers or nuts, measured from their top edge.
# field-asm-fastener-size = Nominal Size
# field-asm-fastener-size-help = Thread designation, such as M10 for coarse pitch or M10×1.25 for fine pitch, or a bearing number such as 608.
# field-asm-joint-align-angle = Alignment Angle
# field-asm-joint-align-angle-help = Rotates component 1 around the aligned origin's Z axis.
# field-asm-joint-align-flip = Flip Alignment
# field-asm-joint-align-flip-help = Flips component 1 for alignment. Faces oppose each other by default.
# field-asm-joint-angle = Angle
# field-asm-joint-angle-help = Angle about the axis (the origin's Z axis), measured from the initial position. Drag the slider to preview motion. Values must stay within the limits.
# field-asm-joint-angle-max = Maximum Angle
# field-asm-joint-angle-max-help = Blank leaves this unspecified.
# field-asm-joint-angle-min = Minimum Angle
# field-asm-joint-angle-min-help = Blank leaves this unspecified.
# field-asm-joint-angle-rest = Angle Rest Position
# field-asm-joint-angle-rest-help = Blank disables return. A dragged component or slider returns to this value when released.
# field-asm-joint-distance = Distance
# field-asm-joint-distance-help = Distance along the axis, measured from the initial position. Drag the slider to preview motion. Values must stay within the limits.
# field-asm-joint-distance-max = Maximum Distance
# field-asm-joint-distance-max-help = Blank leaves this unspecified.
# field-asm-joint-distance-min = Minimum Distance
# field-asm-joint-distance-min-help = Blank leaves this unspecified.
# field-asm-joint-distance-rest = Distance Rest Position
# field-asm-joint-distance-rest-help = Blank disables return. A dragged component or slider returns to this value when released.
# field-asm-joint-drive-by = Drive Mode
# field-asm-joint-drive-by-help = Linked motion derives rotary angles or slider distances from the driving joint's value.
# field-asm-joint-flip = Reverse Motion
# field-asm-joint-flip-help = Reverses rotation or translation.
# field-asm-joint-kind = Type
# field-asm-joint-kind-help = Rigid moves components together. Revolute rotates about the axis; Slider translates along it. Cylindrical allows both. Pin-slot rotates and translates along X. Planar translates in X/Y and rotates about the axis. Ball rotates in any direction.
# field-asm-joint-link-flip = Reverse Linked Motion
# field-asm-joint-link-flip-help = Moves opposite to the driving joint.
# field-asm-joint-link-follow = Driven Motion
# field-asm-joint-link-follow-help = Motion of this joint; blank means 360 deg or 10 mm.
# field-asm-joint-link-joint = Driving Joint
# field-asm-joint-link-joint-help = A rotary or slider joint earlier in the timeline.
# field-asm-joint-link-lead = Driving Motion
# field-asm-joint-link-lead-help = Driving motion for the ratio: angle for rotary joints or distance for sliders. Blank means 360 deg or 10 mm.
# field-asm-joint-offset-x = X Offset
# field-asm-joint-offset-x-help = Offsets along component 2's origin X direction.
# field-asm-joint-offset-y = Y Offset
# field-asm-joint-offset-y-help = Offsets along component 2's origin Y direction.
# field-asm-joint-offset-z = Z Offset
# field-asm-joint-offset-z-help = Offsets along component 2's origin Z direction, separating the faces.
# field-asm-joint-slide-x = X Distance
# field-asm-joint-slide-x-help = Distance along the origin's X axis, measured from the initial position. Drag the slider to preview motion. Values must stay within the limits.
# field-asm-joint-slide-x-max = Maximum X Distance
# field-asm-joint-slide-x-max-help = Blank leaves this unspecified.
# field-asm-joint-slide-x-min = Minimum X Distance
# field-asm-joint-slide-x-min-help = Blank leaves this unspecified.
# field-asm-joint-slide-x-rest = X Distance Rest Position
# field-asm-joint-slide-x-rest-help = Blank disables return. A dragged component or slider returns to this value when released.
# field-asm-joint-slide-y = Y Distance
# field-asm-joint-slide-y-help = Distance along the origin's Y axis, measured from the initial position. Drag the slider to preview motion. Values must stay within the limits.
# field-asm-joint-slide-y-max = Maximum Y Distance
# field-asm-joint-slide-y-max-help = Blank leaves this unspecified.
# field-asm-joint-slide-y-min = Minimum Y Distance
# field-asm-joint-slide-y-min-help = Blank leaves this unspecified.
# field-asm-joint-slide-y-rest = Y Distance Rest Position
# field-asm-joint-slide-y-rest-help = Blank disables return. A dragged component or slider returns to this value when released.
# field-asm-joint-tilt = Tilt
# field-asm-joint-tilt-help = Tilt angle about the origin's X axis. Drag the slider to preview motion. Values must stay within the limits.
# field-asm-joint-tilt-max = Maximum Tilt
# field-asm-joint-tilt-max-help = Blank leaves this unspecified.
# field-asm-joint-tilt-min = Minimum Tilt
# field-asm-joint-tilt-min-help = Blank leaves this unspecified.
# field-asm-joint-tilt-rest = Tilt Rest Position
# field-asm-joint-tilt-rest-help = Blank disables return. A dragged component or slider returns to this value when released.
# field-asm-joint-twist = Twist
# field-asm-joint-twist-help = Twist angle about the tilted axis. Drag the slider to preview motion. Values must stay within the limits.
# field-asm-joint-twist-max = Maximum Twist
# field-asm-joint-twist-max-help = Blank leaves this unspecified.
# field-asm-joint-twist-min = Minimum Twist
# field-asm-joint-twist-min-help = Blank leaves this unspecified.
# field-asm-joint-twist-rest = Twist Rest Position
# field-asm-joint-twist-rest-help = Blank disables return. A dragged component or slider returns to this value when released.
# field-asm-link-file = Source File
# field-asm-link-pinned = Pin This Version
# field-asm-link-pinned-help = Does not notify or update when the source file changes. Unpin to enable notifications again.
# field-asm-occurrence-of = Original Body
# field-asm-position-x = X Distance
# field-asm-position-x-help = Distance from the position before dragging.
# field-asm-position-y = Y Distance
# field-asm-position-y-help = Distance from the position before dragging.
# field-asm-position-z = Z Distance
# field-asm-position-z-help = Distance from the position before dragging.
