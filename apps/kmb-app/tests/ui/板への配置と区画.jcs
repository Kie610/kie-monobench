# 共通のコマンドから配置を作り、名前で探した欄で並べ方と書き出し方を直す。
#! sample part

click ~作業空間:
click "設計"
click "button:穴の並び"
run cam.nest.create width=140 depth=90 height=15
click "button:~OK"
key Escape
click ~作業空間:
click "加工"
expect "板への配置" exists
key ctrl+z
expect "板への配置" missing
key ctrl+y
expect "板への配置" exists

click "button:板への配置"
run cam.nest.set_part part=1 count=3 rotate=fixed
click ~作業空間:
click "加工"
dclick "button:板への配置"
expect "縁の余白" = "5 mm"
expect "部品の間" = "8 mm"
select "並べ方" "形どおり"
expect "格子の目" exists
type "格子の目" 2
expect "格子の目" = "2 mm"
select "並べ方" "外形の箱"
expect "格子の目" = "2 mm"
select "区画の書き出し" "止めを入れた 1 ファイル"
expect "区画の書き出し" = "止めを入れた 1 ファイル"
click "button:~OK"
key Escape
dclick "button:板への配置"
expect "区画の書き出し" = "止めを入れた 1 ファイル"
key Escape
run cam.add.contour
click "button:~OK"
key Escape
click "全体表示"
shot 板への配置と区画
