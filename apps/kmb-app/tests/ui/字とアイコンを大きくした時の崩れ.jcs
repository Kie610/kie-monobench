# 字とアイコンを 250 % にしても、ビューの周り・タイムライン・編集パネル・文書のタブが重ならずに押せる。
# 選ぶ種類はツールバーの「選択」だけ、表示の形は下の帯の「表示 ▾」だけ。レンダリングと解析では
# 下のタイムラインを出さない(設計へ戻すとまた出る)。
#! sample part

shot 100

# 設定の窓で字とアイコンを 250 % にする(人と同じく欄に打つ。この欄は Enter で決まる)
click "設定"
type "字の大きさ" 250 enter
expect "字の大きさ" = 250 %
type "アイコンの大きさ" 250 enter
expect "アイコンの大きさ" = 250 %
# 窓は上の帯の歯車に重なるので、窓の × で閉じる
click "Close window"
expect "字の大きさ" missing
shot 設計-250

# 選ぶ種類はツールバーの「選択」で選ぶ(ビューの左上には出さない。1 か所だけなのは
# kmb-ui の scale_tests で数える。`missing` は `#2` を見ないので台本では数えられない)
expect "頂点" exists
# 表示の形は下の帯の「表示 ▾」から選ぶ(右上の「表示設定」は無い)
expect "表示設定" missing
click "表示"
click "ワイヤフレーム"
key Escape
click "表示"
click "シェーディング、エッジ表示のみ"
key Escape

# タイムラインの札をダブルクリックすると編集パネルに出る。見出しの × で閉じる
dclick "穴の並び"
expect "編集パネルを隠す" exists
shot 穴の並び-250
click "編集パネルを隠す"
expect "編集パネルを隠す" missing

# 視点の軸と全画面のボタン、等角のボタンが押せる
click "全画面表示"
expect "全画面表示を終了" exists
click "全画面表示を終了"
click "等角"

# ブラウザを隠すと左の端に出るつまみで戻せる
click "表示"
click "checkbox:ブラウザ"
key Escape
expect "ブラウザを出す" exists
shot ブラウザを隠した-250
click "ブラウザを出す"
expect "ブラウザを出す" missing

# レンダリングと解析では下のタイムラインを出さない。設計へ戻すとまた出る
expect "ロールバックの棒を先頭へ" exists
click ~"作業空間:"
click "レンダリング"
expect "ロールバックの棒を先頭へ" missing
shot レンダリング-250
click ~"作業空間:"
click "解析"
expect "ロールバックの棒を先頭へ" missing
# 加工は段の帯、アニメーションはストーリーボード(下の帯の枠と左のボタンの作りはタイムラインと同じ)
click ~"作業空間:"
click "加工"
expect "前へ" exists
shot 加工-250
click ~"作業空間:"
click "アニメーション"
expect "初めへ" exists
shot アニメーション-250
click ~"作業空間:"
click "設計"
expect "ロールバックの棒を先頭へ" exists

# 文書のタブを 10 枚開いても、上の帯のコマンド検索と「+」が画面に残る
click "新しいタブ"
click "新しいタブ"
click "新しいタブ"
click "新しいタブ"
click "新しいタブ"
click "新しいタブ"
click "新しいタブ"
click "新しいタブ"
click "新しいタブ"
expect "新しいタブ" exists
expect "コマンド検索" exists
shot タブ10枚-250
