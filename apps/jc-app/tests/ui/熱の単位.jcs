# 熱解析の欄に数だけを打つと、その欄の単位(℃・W・W/(m²·K))で入り、解けること。
# 人の手順どおりに、作業空間を替え、熱の研究を足し、面を選んで値を打ち、実行する。
#! sample part

# 作業空間を解析に替える
click ~作業空間:
click "解析"
shot 解析の作業空間

# 熱の研究を足す(編集パネルが開く)
click "熱"

# 熱が入る面: 見本の行に、板の端の面を選んで 20 W
click "面を選ぶ"
pick f8:end
type "熱(W、面全体)" 20
expect "熱(W、面全体)" = 20

# 温度を決める面を 1 つ足して 50 ℃(新しい行の欄は空から打つ)
click "+"#1
pick f8:side:e6
# 2 つの行(熱が入る面・温度を決める面)に面が 1 つずつ入った(入らない行は値を読まずに飛ばすので、
# 値だけ確かめても温度の行が効いたかは分からない)
expect "1 個を選択"#2
expect "1 個を選択"#3 missing
type "温度(℃)" 50
expect "温度(℃)" = 50

# まわりの温度を空にしてから 25 ℃(空の欄に数だけを打つ)
type "まわりの温度(℃)" ""
type "まわりの温度(℃)" 25
expect "まわりの温度(℃)" = 25
expect ~数だけで書いてください missing
shot 値を打った後

# 決めて、解く
click ~OK
click "▶  実行"
until "済み" 300s
# 温度を決める面の 50 ℃が効いている(面が入らないと、まわりの温度へ逃げるだけで最低は 50 ℃にならない)
expect ~"最低の温度: 50.00 ℃"
shot 解いた後
